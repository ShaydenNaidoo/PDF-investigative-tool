{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PDF Analyzer",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/pdf-analyzer/server.py",
        "--port",
        "8766",
        "--open"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    }
  ]
}
